# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://kanbit:kanbit@localhost:5433/kanbit
# Single 7-day session JWT in v1.0 (no refresh token). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave empty locally (host-only cookie). Production: COOKIE_DOMAIN=.kanbit.app
COOKIE_DOMAIN=
# Frontend origin allowed by CORS (credentials: true)
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Optional initial teacher. When both are set the API creates the account at boot
# if it is missing (an existing password is never overwritten). `pnpm db:seed` does
# the same locally. Password: at least 8 characters. Name defaults to "Docente".
SEED_TEACHER_USERNAME=
SEED_TEACHER_PASSWORD=
SEED_TEACHER_NAME=
