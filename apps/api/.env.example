# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://kanbit:kanbit@localhost:5433/kanbit
# Single 7-day session JWT in v1.0 (no refresh token). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave empty locally (host-only cookie). Production: .kanbit.app
COOKIE_DOMAIN=
# Frontend origin allowed by CORS (credentials: true)
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Optional: initial teacher account created by the seed (v1.0 auth stage)
SEED_TEACHER_USERNAME=
SEED_TEACHER_PASSWORD=
